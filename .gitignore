# .gitignore

# IDE & Editors
.idea/
.vscode/
*.swp
*.swo
*.iml
.DS_Store
Thumbs.db
.project
.classpath
**/.classpath
.settings/
**/.settings/

# Build Artifacts
target/
build/
dist/
.gradle/
*.class
*.exe

# Node
node_modules/
**/node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Environment & Secrets
.env
.env.*
*.env
!.env.example
!**/.env.example
sendgrid.env
backend/sendgrid.env
backend/.env

# Data & Databases
backend/data/
data/
*.db

# Next.js & Build Artifacts
frontend/.next/
.next/
frontend/out/
out/
.turbo/
*.tsbuildinfo

# OS Files
*.log
logs/
*.pid
*.seed
*.pid.lock

# Misc
.cache/
tmp/
*.bak
*.orig
*.tmp

# Coverage
coverage/
*.lcov
.nyc_output/

# Generated lock files (optional - adjust as needed)
# package-lock.json
# yarn.lock
