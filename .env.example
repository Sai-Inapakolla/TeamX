# ==========================================
# TeamX SaaS - Environment Configuration Template
# Copy this file to .env and replace with production values
# ==========================================

# Database Settings (Azure SQL Server)
SPRING_DATASOURCE_URL=jdbc:sqlserver://your-server.database.windows.net:1433;database=teamX;encrypt=true;trustServerCertificate=false;hostNameInCertificate=*.database.windows.net;loginTimeout=30;
SPRING_DATASOURCE_USERNAME=TeamX-Admin@your-server
SPRING_DATASOURCE_PASSWORD=your_azure_sql_password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.microsoft.sqlserver.jdbc.SQLServerDriver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.SQLServerDialect

# Security & JWT Token Config (REQUIRED IN PRODUCTION)
# Must be a secure random 256-bit (32+ character) string
JWT_SECRET=replace_with_a_secure_random_256_bit_secret_key_in_production!

# CORS Allowed Origins (Comma-separated list of allowed frontend URLs)
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://app.your-domain.com,http://localhost:3000

# Cloud Services (Optional)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@your-domain.com

# Frontend API URL
NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com/api/v1
